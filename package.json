{
  "name": "savit",
  "private": true,
  "version": "0.1.0",
  "description": "A self-hosted bookmark manager — save links from anywhere and browse them as a list, a grid, or a 3D constellation.",
  "license": "MIT",
  "author": "Naveen Akalanka",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
