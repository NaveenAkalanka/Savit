# Copy this file to .env and fill in your own values.
# `cp .env.example .env`   (macOS/Linux)
# `copy .env.example .env` (Windows)

# Required. Create a free database at https://turso.tech, then get its URL
# via `turso db show <database-name> --url` or the Turso dashboard.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Required for a hosted Turso database (get via `turso db tokens create <database-name>`).
# Not needed if TURSO_DATABASE_URL points at a local file:// database instead.
TURSO_AUTH_TOKEN=your-turso-auth-token

# Optional — all have sensible defaults, uncomment to override.
# SAVIT_PORT=4318
# SAVIT_HOST=127.0.0.1
# SAVIT_STATIC_DIR=
